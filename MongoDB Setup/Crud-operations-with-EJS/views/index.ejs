<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full h-full bg-zinc-900 p-10">
        <div class="nav flex gap-3 mb-6">
            <a href="/read" class="text-blue-500 hover:text-white">View Users</a>
        </div>
        <h1 class ="text-3xl tracking-tighter text-white mb-6">Create User</h1>
        <form action="/create" method="POST" class="flex gap-3">
            
            <input class="px-5 py-3 bg-transparent border border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500 rounded text-white" type="text" name="name" placeholder="Enter your name">
            <input class="px-5 py-3 bg-transparent border border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500 rounded text-white" type="text" name="email" placeholder="Enter your email">
            <input class="px-5 py-3 bg-transparent border border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500 rounded text-white" type="text" name="image" placeholder="Enter your image url">
            <input class="px-5 py-3 bg-blue-500 text-white rounded-lg ml-3 hover:bg-blue-600" type="submit" value="Create User">
        </form>
    </div>

    
</body>
</html>